<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/com11h_logo"
        android:label="Food KCN"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".HomeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BannerViewActivity"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LegacyRouterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ImageGalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LiveListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LiveWatchActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SellerLiveActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SellerLoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
